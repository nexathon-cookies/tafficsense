<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Include -->
        <include
            android:id="@+id/header"
            layout="@layout/layout_app_header" />

        <!-- Floating Controls Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_card"
            android:elevation="2dp"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <!-- Switcher Row: Segmented Map/List toggle + Live Clock Pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Segmented Toggle Pill -->
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/toggle_view_mode"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    app:checkedButton="@id/btn_view_map"
                    app:selectionRequired="true"
                    app:singleSelection="true">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_map"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Map"
                        android:textSize="12sp"
                        app:backgroundTint="@color/btn_toggle_bg_selector"
                        android:textColor="@color/btn_toggle_text_selector"
                        app:iconTint="@color/btn_toggle_text_selector"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_map"
                        app:iconSize="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_view_list"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="List"
                        android:textSize="12sp"
                        app:backgroundTint="@color/btn_toggle_bg_selector"
                        android:textColor="@color/btn_toggle_text_selector"
                        app:iconTint="@color/btn_toggle_text_selector"
                        app:strokeColor="@color/border"
                        app:strokeWidth="1dp"
                        app:cornerRadius="19dp"
                        app:icon="@drawable/ic_alt_route"
                        app:iconSize="14dp" />
                </com.google.android.material.button.MaterialButtonToggleGroup>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Live Sync Pill -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill_violet"
                    android:backgroundTint="@color/surface_container"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="4dp">

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_circle_icon"
                        android:backgroundTint="@color/live_green" />

                    <TextView
                        android:id="@+id/tv_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:text="09:42"
                        android:textColor="@color/text_primary"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Search Bar Input for Landmarks & Corridors -->
            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                app:boxBackgroundColor="@color/surface_container"
                app:boxCornerRadiusBottomEnd="10dp"
                app:boxCornerRadiusBottomStart="10dp"
                app:boxCornerRadiusTopEnd="10dp"
                app:boxCornerRadiusTopStart="10dp"
                app:boxStrokeWidth="0dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintEnabled="false"
                app:startIconDrawable="@drawable/ic_explore"
                app:startIconTint="@color/text_muted">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_traffic"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Search Mangaluru corridor, landmark..."
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:paddingTop="0dp"
                    android:paddingBottom="0dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp" />
            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

        <!-- Main Content Area -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Interactive Map View -->
            <WebView
                android:id="@+id/web_view_map"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Floating Map Controls (Google Maps / OSM Style) -->
            <LinearLayout
                android:id="@+id/layout_map_controls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- Zoom Controls Pill -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="44dp"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:id="@+id/btn_map_zoom_in"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp"
                            android:src="@drawable/ic_add"
                            app:tint="@color/text_primary" />

                        <View
                            android:layout_width="28dp"
                            android:layout_height="1dp"
                            android:background="@color/border" />

                        <ImageView
                            android:id="@+id/btn_map_zoom_out"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="12dp"
                            android:src="@drawable/ic_remove"
                            app:tint="@color/text_primary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Recenter on Mangaluru / My Location Button -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btn_map_recenter"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_card"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="6dp"
                    app:strokeColor="@color/border"
                    app:strokeWidth="1dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="11dp"
                        android:src="@drawable/ic_my_location"
                        app:tint="@color/primary" />
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Incident Feed List View -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_traffic_list"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingStart="16dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="100dp"
                android:visibility="gone" />

            <!-- Empty State for List Mode -->
            <LinearLayout
                android:id="@+id/layout_empty_traffic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="32dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/surface_container"
                    android:padding="14dp"
                    android:src="@drawable/ic_radar"
                    app:tint="@color/primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="No Hazards Found"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="All monitored Mangaluru corridors are flowing smoothly, or no incidents match your search filter."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_clear_search"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="16dp"
                    android:text="Clear Search"
                    android:textColor="@color/primary"
                    android:textSize="12sp"
                    app:backgroundTint="@color/primary_container"
                    app:cornerRadius="20dp" />
            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

    <!-- Interactive Details Card for Selected Location or Incident -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottom_sheet_incident"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="16dp"
        app:cardElevation="12dp"
        app:strokeColor="@color/border"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Row: Icon + Title + Badge + Close Button -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_sheet_icon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="@color/error_container"
                    android:padding="7dp"
                    android:src="@drawable/ic_car_crash"
                    app:tint="@color/error" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_sheet_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Collision near Pumpwell"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_sheet_landmark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pumpwell Flyover Service Road"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tv_sheet_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_pill_violet"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="L3 Corroborated"
                    android:textColor="@color/secondary"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <!-- Dismiss Button -->
                <ImageView
                    android:id="@+id/iv_sheet_close"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"
                    android:padding="5dp"
                    android:src="@drawable/ic_close"
                    app:tint="@color/text_muted" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_sheet_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Obstacle observed on corridor transit. Expect 5 min delay on south leg."
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <!-- Action Buttons for Incident Mode -->
            <LinearLayout
                android:id="@+id/layout_incident_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sheet_corroborate"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Still there?"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp"
                    app:backgroundTint="@color/primary_container"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_thumb_up"
                    app:iconSize="14dp"
                    app:iconTint="@color/on_primary_container" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_sheet_plan_detour"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@color/btn_primary_bg_selector"
                    android:text="Plan Detour"
                    android:textColor="@color/btn_primary_text_selector"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_alt_route"
                    app:iconSize="14dp"
                    app:iconTint="@color/btn_primary_text_selector" />
            </LinearLayout>

            <!-- Action Buttons for Selected Place / Point Mode -->
            <LinearLayout
                android:id="@+id/layout_place_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_place_report_here"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:text="Report Hazard"
                    android:textColor="@color/on_primary_container"
                    android:textSize="12sp"
                    app:backgroundTint="@color/primary_container"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1dp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_add"
                    app:iconSize="14dp"
                    app:iconTint="@color/on_primary_container" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_place_plan_route"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    app:backgroundTint="@color/btn_primary_bg_selector"
                    android:text="Plan Route Here"
                    android:textColor="@color/btn_primary_text_selector"
                    android:textSize="12sp"
                    app:cornerRadius="8dp"
                    app:icon="@drawable/ic_alt_route"
                    app:iconTint="@color/btn_primary_text_selector" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
