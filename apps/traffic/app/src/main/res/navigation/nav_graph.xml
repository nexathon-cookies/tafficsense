<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_home">

    <fragment
        android:id="@+id/navigation_home"
        android:name="com.love.trafficsense.ui.home.HomeFragment"
        android:label="Home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/navigation_traffic"
        android:name="com.love.trafficsense.ui.traffic.TrafficFragment"
        android:label="Live Traffic"
        tools:layout="@layout/fragment_traffic" />

    <fragment
        android:id="@+id/navigation_report"
        android:name="com.love.trafficsense.ui.report.ReportFragment"
        android:label="Report Hazard"
        tools:layout="@layout/fragment_report" />

    <fragment
        android:id="@+id/navigation_planner"
        android:name="com.love.trafficsense.ui.planner.PlannerFragment"
        android:label="Route Planner"
        tools:layout="@layout/fragment_planner" />

    <fragment
        android:id="@+id/navigation_workspace"
        android:name="com.love.trafficsense.ui.workspace.WorkspaceFragment"
        android:label="Me"
        tools:layout="@layout/fragment_workspace" />

</navigation>
